#!/bin/sh
# The flatpak's command: the bundle's launcher with a per-user observant.toml, autostarted at sign-in unless switched off.
# A flatpak has no boot-time service; `omni-observant --autostart off|on` toggles the sign-in start.
set -eu
app=/app/observant
config_dir="${XDG_CONFIG_HOME:-$HOME/.config}/omni-accelerant"
config="${config_dir}/observant.toml"
# The host's autostart directory; finish-arg xdg-config/autostart:create mounts it at this path.
entry="${HOME}/.config/autostart/${FLATPAK_ID}.desktop"

write_entry() {
  mkdir -p "$(dirname "${entry}")"
  cat > "${entry}" <<EOF
[Desktop Entry]
Type=Application
Name=ObservANT
Comment=Starts ObservANT at sign-in; its page is http://localhost:8080/
Exec=flatpak run --command=omni-observant ${FLATPAK_ID}
X-Flatpak=${FLATPAK_ID}
Terminal=false
EOF
}

case "${1:-}" in
  --autostart)
    mkdir -p "${config_dir}"
    case "${2:-}" in
      on) rm -f "${config_dir}/no-autostart"; write_entry; echo "autostart at sign-in: on" ;;
      off) touch "${config_dir}/no-autostart"; rm -f "${entry}"; echo "autostart at sign-in: off" ;;
      *) echo "usage: omni-observant --autostart on|off" >&2; exit 2 ;;
    esac
    exit 0 ;;
esac

if [ ! -f "${config}" ]; then
  mkdir -p "${config_dir}"
  cp "${app}/share/omni-observant/observant.toml" "${config}"
fi
if [ ! -e "${config_dir}/no-autostart" ] && [ ! -e "${entry}" ]; then
  write_entry
fi
# No systemd here: the sandbox's own state directory keeps the cat's visits across restarts.
export STATE_DIRECTORY="${STATE_DIRECTORY:-${XDG_STATE_HOME:-$HOME/.local/state}/omni-observant}"
exec "${app}/observant" --config "${config}" "$@"
