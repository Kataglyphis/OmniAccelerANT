#!/bin/sh
# Installs this bundle as the omni-observant service where no .deb fits (the AppImage's --install); postinst runs `setup`.
set -eu

package=omni-observant
prefix="/opt/${package}"
unit=omni-observant.service
unit_file="/etc/systemd/system/${unit}"
user=omni-observant
config=/etc/omni-accelerant/observant.toml
here="$(cd -- "$(dirname -- "$(readlink -f -- "$0")")/.." && pwd)"
share="${here}/share/${package}"

usage() {
  cat <<'EOF'
usage: observant --install [--no-autostart]
       observant --uninstall [--purge]

  --install       copy ObservANT to /opt/omni-observant and run it as the
                  omni-observant service from boot; again with a newer copy, it upgrades
  --no-autostart  install, but leave the service disabled
                  (start it later with: sudo systemctl enable --now omni-observant)
  --uninstall     stop and remove the service and /opt/omni-observant;
                  /etc/omni-accelerant/observant.toml stays
  --purge         with --uninstall: remove the settings, the state and the user too
EOF
}

have_systemd() { [ -d /run/systemd/system ]; }

deb_installed() {
  command -v dpkg-query >/dev/null 2>&1 &&
    dpkg-query -W -f='${Status}' "${package}" 2>/dev/null | grep -q 'ok installed'
}

make_user() {
  if ! getent passwd "${user}" >/dev/null; then
    useradd --system --no-create-home --home-dir "/var/lib/${package}" --shell /usr/sbin/nologin "${user}"
  fi
  # The camera nodes and the dma-heaps a Pi camera allocates from belong to these, depending on the OS.
  for group in video render; do
    if getent group "${group}" >/dev/null; then
      usermod -a -G "${group}" "${user}"
    fi
  done
}

# An install from before ObservANT (omni-accelerant-catcam, until 2026-10-14) hands over its settings, its
# visits, photos and clips, and its firewall rule; the old copies stay where they were.
migrate_legacy() {
  old_config=/etc/omni-accelerant/catcam.toml
  old_state=/var/lib/omni-accelerant-catcam
  if [ ! -e "${config}" ] && [ -f "${old_config}" ]; then
    install -D -m 640 -g "$(id -gn "${user}")" "${old_config}" "${config}"
    printf 'settings: took over %s\n' "${old_config}"
  fi
  if [ -d "${old_state}" ] && [ ! -e "/var/lib/${package}" ]; then
    cp -a "${old_state}" "/var/lib/${package}"
    chown -R "${user}:$(id -gn "${user}")" "/var/lib/${package}"
    printf 'visits, photos and clips: took over %s\n' "${old_state}"
  fi
  if command -v ufw >/dev/null 2>&1 && [ -f /etc/ufw/applications.d/omni-observant ] &&
    ufw status 2>/dev/null | grep -q OmniCatCam && ! ufw status 2>/dev/null | grep -q OmniObservANT; then
    ufw allow OmniObservANT >/dev/null && printf 'firewall: OmniObservANT allowed, as OmniCatCam was\n'
  fi
  # The removed .deb leaves its unit masked and its boot link dangling; forget both, as a purge would.
  if command -v deb-systemd-helper >/dev/null 2>&1 &&
    [ -L /etc/systemd/system/multi-user.target.wants/omni-catcam.service ]; then
    DPKG_MAINTSCRIPT_PACKAGE=omni-accelerant-catcam deb-systemd-helper purge omni-catcam.service >/dev/null 2>&1 || true
    DPKG_MAINTSCRIPT_PACKAGE=omni-accelerant-catcam deb-systemd-helper unmask omni-catcam.service >/dev/null 2>&1 || true
  fi
  # The AppImage's install from before ran its own unit; two would fight over port 8080.
  if [ -f /etc/systemd/system/omni-catcam.service ] && [ ! -L /etc/systemd/system/omni-catcam.service ]; then
    if have_systemd; then
      systemctl disable --now omni-catcam.service 2>/dev/null || true
    fi
    rm -f /etc/systemd/system/omni-catcam.service /usr/local/bin/omni-catcam
    rm -rf /opt/omni-accelerant-catcam
    printf 'removed the AppImage install from before ObservANT\n'
  fi
  return 0
}

# Never over the admin's file, and only the service's group reads it: a notify_url can carry a webhook secret.
make_config() {
  service_group="$(id -gn "${user}")"
  if [ ! -e "${config}" ]; then
    install -D -m 640 -g "${service_group}" "${share}/observant.toml" "${config}"
  elif [ -n "$(find "${config}" -perm -o=r)" ]; then
    # Versions before 2026-10-13 wrote it world-readable.
    chgrp "${service_group}" "${config}"
    chmod o-rwx "${config}"
  fi
}

install_bundle() {
  autostart="$1"
  if deb_installed; then
    printf 'the %s .deb is installed: upgrade it with the .deb, or remove it first\n' "${package}" >&2
    exit 1
  fi
  [ "${here}" != "${prefix}" ] || { printf 'this is the installed copy; run --install from the AppImage\n' >&2; exit 1; }
  # A removed, unpurged .deb keeps deb-systemd-helper's record; a .deb back later would read our disable as the admin's.
  if command -v deb-systemd-helper >/dev/null 2>&1 &&
    dpkg-query -W -f='${Status}' "${package}" 2>/dev/null | grep -q 'config-files'; then
    # deb-systemd-helper runs only for a package's maintainer script; this takes over that package's unit.
    DPKG_MAINTSCRIPT_PACKAGE="${package}" deb-systemd-helper unmask "${unit}" >/dev/null 2>&1 || true
    DPKG_MAINTSCRIPT_PACKAGE="${package}" deb-systemd-helper purge "${unit}" >/dev/null 2>&1 || true
  fi
  # A removed .deb leaves its mask (a link to /dev/null) here; that is a first install, not an upgrade to respect.
  fresh=true
  if [ -e "${unit_file}" ] && [ "$(readlink "${unit_file}")" != /dev/null ]; then
    fresh=false
  fi

  # The source may be the AppImage's read-only mount, owned by whoever built it.
  rm -rf "${prefix}.new"
  mkdir -p "$(dirname "${prefix}")"
  cp -a --no-preserve=ownership "${here}/." "${prefix}.new"
  if have_systemd; then
    systemctl stop "${unit}" 2>/dev/null || true
  fi
  rm -rf "${prefix}"
  mv "${prefix}.new" "${prefix}"

  install -m 644 "${share}/omni-observant.service" "${unit_file}"
  make_user
  if [ -d /etc/ufw/applications.d ]; then
    install -m 644 "${share}/ufw-omni-observant" /etc/ufw/applications.d/omni-observant
  fi
  migrate_legacy
  make_config
  mkdir -p /usr/local/bin
  ln -sfn "${prefix}/observant" /usr/local/bin/omni-observant

  if have_systemd; then
    systemctl daemon-reload
    if [ "${autostart}" = false ]; then
      systemctl disable "${unit}" 2>/dev/null || true
    elif [ "${fresh}" = true ]; then
      systemctl enable "${unit}"
    fi
    # An upgrade keeps the admin's choice: an enabled service restarts, a disabled one stays off.
    if systemctl -q is-enabled "${unit}"; then
      systemctl restart "${unit}"
    fi
    printf 'installed: %s\n' "$(systemctl is-enabled "${unit}" 2>/dev/null || true)"
  else
    printf 'installed; no systemd here, so start it with: %s/observant\n' "${prefix}"
  fi
  printf 'the page: http://%s:8080/  settings: %s\n' "$(uname -n)" "${config}"
  if command -v firewall-cmd >/dev/null 2>&1; then
    printf 'firewalld: sudo firewall-cmd --permanent --add-port=8080/tcp --add-port=40000-40099/udp && sudo firewall-cmd --reload\n'
  elif [ -d /etc/ufw/applications.d ]; then
    printf 'ufw: sudo ufw allow OmniObservANT\n'
  fi
}

uninstall_bundle() {
  purge="$1"
  if deb_installed; then
    printf 'the %s .deb is installed: remove it with apt\n' "${package}" >&2
    exit 1
  fi
  if have_systemd; then
    systemctl disable --now "${unit}" 2>/dev/null || true
  fi
  rm -f "${unit_file}" /usr/local/bin/omni-observant
  if have_systemd; then
    systemctl daemon-reload
  fi
  rm -rf "${prefix}"
  if [ "${purge}" = true ]; then
    rm -f "${config}" /etc/ufw/applications.d/omni-observant
    rmdir /etc/omni-accelerant 2>/dev/null || true
    rm -rf "/var/lib/${package}"
    if getent passwd "${user}" >/dev/null; then
      userdel "${user}"
    fi
  fi
  printf 'uninstalled%s\n' "$([ "${purge}" = true ] && printf ', settings and user included')"
}

[ "$(id -u)" -eq 0 ] || { printf 'run it as root: sudo <the AppImage or observant> %s\n' "$*" >&2; exit 1; }
case "${1:-}" in
  setup)
    make_user
    migrate_legacy
    make_config
    ;;
  --install)
    case "${2:-}" in
      "") install_bundle true ;;
      --no-autostart) install_bundle false ;;
      *) usage >&2; exit 2 ;;
    esac
    ;;
  --uninstall)
    case "${2:-}" in
      "") uninstall_bundle false ;;
      --purge) uninstall_bundle true ;;
      *) usage >&2; exit 2 ;;
    esac
    ;;
  *) usage >&2; exit 2 ;;
esac
