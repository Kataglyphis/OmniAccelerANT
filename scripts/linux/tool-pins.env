# Data read by the hub's load_versions_env, never sourced; bump a version and every checksum beside it together.

# codeql_install_cli; checksums from the release's codeql-<asset>.zip.checksum.txt files.
# renovate: datasource=github-releases depName=github/codeql-cli-binaries
CODEQL_CLI_VERSION=v2.27.3
CODEQL_CLI_LINUX64_SHA256=845075a2fa2fdf72629adc6cbde6264691b698d1f294bd27f10c6b579cd750a4
CODEQL_CLI_LINUX_ARM64_SHA256=4d9001f704f3e3e9145e2ac3db23bda323968f9f674cb1b507f195abddea0170

# build-firmware.sh; espup publishes no checksum file, so these match GitHub's asset digests and a local sha256sum.
# renovate: datasource=github-releases depName=esp-rs/espup
ESPUP_VERSION=v0.19.0
ESPUP_X86_64_SHA256=f31411c64dffff4da0f0e23c432b9a5fda48942ff8695b8b21009ceb7007bcc0
ESPUP_AARCH64_SHA256=a7e841449edbc78ce2443416e90027890b52896698767b6e45a5caafc880498b

# build-firmware.sh; espflash publishes no checksum file, so these match GitHub's asset digests and a local sha256sum.
# renovate: datasource=github-releases depName=esp-rs/espflash
ESPFLASH_VERSION=v4.6.0
ESPFLASH_X86_64_SHA256=c4fcfa32ddc3155608f003a230e6f3c184eff9641ec9cfa8eb54f1b515d403e7
