[Unit]
Description=OmniAccelerANT cat cam (camera, YOLO cat boxes, WebRTC, web page on :8080)
Documentation=https://github.com/Kataglyphis/OmniAccelerANT
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=omni-catcam
ExecStart=/opt/omni-accelerant-catcam/catcam
Restart=on-failure
RestartSec=5
StateDirectory=omni-accelerant-catcam
Environment=HOME=/var/lib/omni-accelerant-catcam
Environment=GST_REGISTRY=/var/lib/omni-accelerant-catcam/gst-registry.bin
NoNewPrivileges=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
