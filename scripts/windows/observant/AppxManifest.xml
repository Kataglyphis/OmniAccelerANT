<?xml version="1.0" encoding="utf-8"?>
<!-- ObservANT's MSIX; Package-ObservANT.ps1 -Msix fills the __TOKENS__ through the hub's Invoke-MsixPackage. -->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap3="http://schemas.microsoft.com/appx/manifest/uap/windows10/3"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  xmlns:desktop2="http://schemas.microsoft.com/appx/manifest/desktop/windows10/2"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap3 desktop desktop2 rescap">

  <Identity Name="Kataglyphis.OmniAccelerANTObservANT" Publisher="__PUBLISHER__" Version="__VERSION__" ProcessorArchitecture="__ARCH__"/>

  <Properties>
    <DisplayName>ObservANT</DisplayName>
    <PublisherDisplayName>Kataglyphis</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26100.0"/>
  </Dependencies>

  <Resources>
    <Resource Language="en-us"/>
  </Resources>

  <Applications>
    <Application Id="ObservANT" Executable="kataglyphis_observant.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements DisplayName="ObservANT" Description="Camera, detection boxes (cats by default) and a WebRTC stream for any browser on the network; the page is http://localhost:8080/"
        BackgroundColor="transparent" Square150x150Logo="Assets\Square150x150Logo.png" Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png"/>
      </uap:VisualElements>
      <Extensions>
        <!-- The MSI's Startup-folder entry, as Windows' own startup task; Task Manager's Startup apps turns it off. -->
        <desktop:Extension Category="windows.startupTask" Executable="kataglyphis_observant.exe" EntryPoint="Windows.FullTrustApplication">
          <desktop:StartupTask TaskId="ObservANTAtLogon" Enabled="true" DisplayName="ObservANT"/>
        </desktop:Extension>
        <!-- The Linux packages' command name, so omni-observant and its flags work from any shell. -->
        <uap3:Extension Category="windows.appExecutionAlias" Executable="kataglyphis_observant.exe" EntryPoint="Windows.FullTrustApplication">
          <uap3:AppExecutionAlias>
            <desktop:ExecutionAlias Alias="omni-observant.exe"/>
          </uap3:AppExecutionAlias>
        </uap3:Extension>
      </Extensions>
    </Application>
  </Applications>

  <!-- MSIX rules take ports and profiles, not a remote scope: the default http_port and ICE range on private and domain networks, where the MSI says LocalSubnet. -->
  <Extensions>
    <desktop2:Extension Category="windows.firewallRules">
      <desktop2:FirewallRules Executable="kataglyphis_observant.exe">
        <desktop2:Rule Direction="in" IPProtocol="TCP" Profile="domainAndPrivate" LocalPortMin="8080" LocalPortMax="8080"/>
        <desktop2:Rule Direction="in" IPProtocol="UDP" Profile="domainAndPrivate" LocalPortMin="40000" LocalPortMax="40099"/>
      </desktop2:FirewallRules>
    </desktop2:Extension>
  </Extensions>

  <Capabilities>
    <Capability Name="internetClientServer"/>
    <Capability Name="privateNetworkClientServer"/>
    <rescap:Capability Name="runFullTrust"/>
    <DeviceCapability Name="webcam"/>
  </Capabilities>
</Package>
