#!/usr/bin/env bash
# The hub's checks of what is staged, then windows-x64.yml's PowerShell lint when a staged file is a script.
set -euo pipefail

_root="$(git rev-parse --show-toplevel)"
export PYTHONUTF8=1
# Read while GIT_INDEX_FILE still names this commit's index: `git commit -a` builds it in a lock file the plain index lacks.
staged="$(git diff --cached --name-only --diff-filter=ACMR)"
# The hub's hook takes that index from the same variable, so it runs before the unset below.
bash "${_root}/third_party/ANTfrastructure/shared/linux/templates/git-hooks/pre-commit"

# Git exports these to hooks; a gate's own `git -C <dir>` would then read this repository's index.
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_PREFIX
cd "${_root}"

# No pipe: grep -q leaves at its first hit, and under pipefail a writer cut off in a long list read as "no script staged".
if grep -qE '^scripts/.*\.psm?1$' <<< "${staged}"; then
  if command -v pwsh >/dev/null 2>&1; then
    echo "pre-commit: PowerShell lint (windows-x64.yml's first step)…"
    pwsh -NoProfile -File third_party/ANTfrastructure/windows/scripts/Invoke-Lint.ps1 -Path scripts || {
      echo "pre-commit: PowerShell lint FAILED — the Windows lanes stop on it before the image pull" >&2
      exit 1
    }
  else
    echo "pre-commit: no pwsh on PATH; the Windows lanes still run the PowerShell lint" >&2
  fi
fi
echo "pre-commit: OK"
