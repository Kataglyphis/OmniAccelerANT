scripts/linux/codeql/codeql-android.sh	# NO --language=java / --language=kotlin, and therefore no c
scripts/linux/lib/antfrastructure.sh	# Replace this process with a ANTfrastructure driver, forwar
scripts/linux/lib/antfrastructure.sh	#!/usr/bin/env bash
scripts/linux/lib/container-steps.sh	# Bare call, and no `|| return 1`: upstream's bootstrap has
scripts/linux/lib/container-steps.sh	# CMake format gate for the hand-maintained native build fil
