*.sh text eol=lf
*.bash text eol=lf
# Workflows run under `shell: pwsh`; CRLF breaks multi-line run: blocks.
.github/**/*.yml text eol=lf
.github/**/*.yaml text eol=lf
# cmake-format --check (line_ending: unix) fails on every CRLF file.
CMakeLists.txt text eol=lf
*.cmake text eol=lf

# Pinned, or each client's core.autocrlf picks the line endings per file.
*.ps1   text eol=crlf
*.psm1  text eol=crlf
*.psd1  text eol=crlf

# The ratchet gates read these over a bind mount; CRLF would put a carriage return in every key.
*.allow text eol=lf

# exclude vendored trees from language analysis
third_party/** linguist-vendored
