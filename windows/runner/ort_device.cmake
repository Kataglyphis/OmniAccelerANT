function(omni_windows_ort_device output oxidant_dir)
  if(NOT DEFINED OMNI_WINDOWS_ORT_PROVIDER OR OMNI_WINDOWS_ORT_PROVIDER STREQUAL "")
    set(OMNI_WINDOWS_ORT_PROVIDER "cpu")
  endif()
  if(NOT OMNI_WINDOWS_ORT_PROVIDER MATCHES "^(cpu|cuda|directml)$")
    message(FATAL_ERROR "OMNI_WINDOWS_ORT_PROVIDER must be cpu, cuda, or directml")
  endif()
  if(NOT OMNI_WINDOWS_ORT_PROVIDER STREQUAL "cpu")
    foreach(_arch IN ITEMS "${FLUTTER_TARGET_PLATFORM}" "${CMAKE_GENERATOR_PLATFORM}" "${CMAKE_CXX_COMPILER_TARGET}")
      if(_arch MATCHES "[Aa][Rr][Mm]|[Aa][Aa][Rr][Cc][Hh]64")
        message(FATAL_ERROR "Windows GPU builds are supported on x64 only")
      endif()
    endforeach()
    set(_manifest "${oxidant_dir}/crates/inference/Cargo.toml")
    if(NOT EXISTS "${_manifest}")
      message(FATAL_ERROR "Windows GPU builds require an OxidANT pin advertising strict provider selection")
    endif()
    file(STRINGS "${_manifest}" _lines)
    set(_in_metadata FALSE)
    set(_supported FALSE)
    foreach(_line IN LISTS _lines)
      if(_line MATCHES "^[ \t]*\\[package\\.metadata\\.kataglyphis\\][ \t]*$")
        set(_in_metadata TRUE)
      elseif(_line MATCHES "^[ \t]*\\[")
        set(_in_metadata FALSE)
      elseif(_in_metadata AND _line MATCHES "^[ \t]*ort-devices[ \t]*=[^\r\n]*\"${OMNI_WINDOWS_ORT_PROVIDER}\"")
        set(_supported TRUE)
      endif()
    endforeach()
    if(NOT _supported)
      message(FATAL_ERROR "Windows GPU builds require an OxidANT pin advertising strict ${OMNI_WINDOWS_ORT_PROVIDER} selection")
    endif()
  endif()
  set(${output} "${OMNI_WINDOWS_ORT_PROVIDER}" PARENT_SCOPE)
endfunction()
